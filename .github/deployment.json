{
  "env": [
    {"name": "SPRING_PROFILES_ACTIVE", "value": "prod"},
    {"name": "DB_PORT", "secretKeyRef": {"name": "shared-db-app", "key": "port"}},
    {"name": "SPRING_DATASOURCE_URL", "value": "jdbc:postgresql://$(DB_HOST):$(DB_PORT)/agent_docs"},
    {"name": "SPRING_DATASOURCE_USERNAME", "secretKeyRef": {"name": "shared-db-app", "key": "username"}},
    {"name": "SPRING_DATASOURCE_PASSWORD", "secretKeyRef": {"name": "shared-db-app", "key": "password"}},
    {"name": "AGENT_DOCS_OWNER", "value": "robinjoon"},
    {"name": "AGENT_DOCS_PUBLIC_URL", "value": "https://agent-docs.homelab.robinjoon.xyz"},
    {"name": "GITHUB_CLIENT_ID", "secretKeyRef": {"name": "agent-docs-runtime", "key": "GITHUB_CLIENT_ID"}},
    {"name": "GITHUB_CLIENT_SECRET", "secretKeyRef": {"name": "agent-docs-runtime", "key": "GITHUB_CLIENT_SECRET"}}
  ]
}
